<?xml version="1.0" encoding="utf-8"?>
<!-- Best Passafe: list item card (white, hairline border; green tint when selected) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <corners android:radius="@dimen/bp_item_radius" />
                    <solid android:color="@color/bp_green_soft" />
                    <stroke android:width="1.5dp" android:color="@color/bp_green" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="@dimen/bp_item_radius" />
                    <solid android:color="?attr/colorSurfaceContainerLowest" />
                    <stroke android:width="1dp" android:color="@color/bp_card_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
