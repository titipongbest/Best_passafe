<?xml version="1.0" encoding="utf-8"?>
<!-- Best Passafe: rounded tile behind a folder icon. The list tints it with the
     folder's own color at low opacity when the folder has one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bp_folder_tile" />
    <corners android:radius="14dp" />
</shape>
